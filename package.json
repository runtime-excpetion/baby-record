{
  "name": "baby-record-system",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.18.0",
  "description": "宝宝成长记录系统 - pnpm monorepo（NestJS 后端 + Vue3 前端）",
  "scripts": {
    "dev": "pnpm dev:frontend",
    "dev:frontend": "pnpm --filter @baby-record/frontend dev",
    "dev:backend": "pnpm --filter @baby-record/backend start:dev",
    "build:frontend": "pnpm --filter @baby-record/frontend build",
    "build:backend": "pnpm --filter @baby-record/backend build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
