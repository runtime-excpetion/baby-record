# ====== 数据库配置 ======
# 注意：密码中的 @ 符号在 DATABASE_URL 中需编码为 %40
# 本服务由以下字段拼接 DATABASE_URL 供 Prisma 使用
DATABASE_HOST=192.168.28.30
DATABASE_PORT=3308
DATABASE_NAME=baby-db
DATABASE_USERNAME=baby_user
DATABASE_PASSWORD=Common@123

# 完整连接串（与上方字段二选一，若填写则优先使用）
# postgresql://baby_user:Common%40123@192.168.28.30:3308/baby-db?schema=public
DATABASE_URL=postgresql://baby_user:Common%40123@192.168.28.30:3308/baby-db?schema=public

# ====== 应用配置 ======
# 服务端口
APP_PORT=3000
# 运行环境
NODE_ENV=development
# API 全局前缀
API_PREFIX=api/v1
# Swagger 文档路径
SWAGGER_PATH=docs
