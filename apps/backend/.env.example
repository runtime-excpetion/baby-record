# ====== 数据库配置 ======
# 注意：密码中的 @ 符号在 DATABASE_URL 中需编码为 %40
# 本服务由以下字段拼接 DATABASE_URL 供 Prisma 使用
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=baby_record
DATABASE_USERNAME=baby_record
DATABASE_PASSWORD=change-this-database-password

# 完整连接串（与上方字段二选一，若填写则优先使用）
# postgresql://baby_record:change-this-database-password@postgres:5432/baby_record?schema=public
DATABASE_URL=postgresql://baby_record:change-this-database-password@postgres:5432/baby_record?schema=public

# ====== 应用配置 ======
# 服务端口
APP_PORT=3000
# 运行环境
NODE_ENV=development
# API 全局前缀
API_PREFIX=api/v1
# Swagger 文档路径
SWAGGER_PATH=docs

# ====== 访问认证 ======
# 至少 6 位；请务必替换，不要提交真实生产密码
BABY_RECORD_PASSWORD=change-this-password
# 登录有效期（天）
BABY_RECORD_SESSION_DAYS=30
# HTTPS 部署设为 true；本地 HTTP 开发设为 false
BABY_RECORD_COOKIE_SECURE=false
# 本地前端开发地址（生产同源部署无需修改）
CORS_ORIGIN=http://localhost:5173
